# Copy this file to .env.local and fill in real values. Never commit .env.local.

# "mock" (default if unset) keeps using lib/data/mock/* — no Supabase project
# needed. Set to "supabase" to use the real backend once the values below are
# filled in and 001_initial_schema.sql / 002_auth_linkage.sql have been
# applied to that project.
NEXT_PUBLIC_DATA_BACKEND=mock

# Supabase project URL and publishable (public) key — from Project Settings
# > API. Safe to expose to the browser: Row Level Security in
# supabase/migrations/* is what actually restricts access, not the secrecy
# of this key. Never put the Secret key (service_role) here or anywhere in
# client code.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (service_role) — Project Settings > API > Secret keys.
# SERVER-ONLY. No NEXT_PUBLIC_ prefix, so Next.js never bundles this into
# browser code. Used exclusively by app/api/applications/* (server route
# handlers) to mint short-lived signed upload URLs for the private
# `application-documents` Storage bucket (007_application_file_uploads.sql)
# — this is the only place in the app that ever touches this key. Never log
# it, never send it in a response body, never import it from a "use client"
# file or anything under lib/data/supabase/* (those stay anon-key-only).
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required (as `Authorization: Bearer <value>`) to call
# POST /api/applications/cleanup-drafts, which deletes abandoned draft
# applications and their Storage files (see that route for the full
# design). Generate any long random string. This project has no cron
# infrastructure of its own (no pg_cron, no Edge Function) — trigger this
# route yourself on a schedule (e.g. Vercel Cron if deployed there, or any
# external scheduler that can send an authenticated HTTP request) once you
# decide how often to run it.
APPLICATIONS_CLEANUP_SECRET=
